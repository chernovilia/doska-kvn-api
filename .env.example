# Скопировать в .env и подставить реальные значения.

# Managed Postgres на Amvera → строка подключения из панели.
DATABASE_URL="postgresql://user:password@host:5432/doska_kvn?schema=public"

# Домен фронта — из этого списка принимаются CORS-запросы.
CORS_ORIGINS="https://xn----7sbhf4acwc1a.xn--p1ai,https://доска-квн.рф,http://localhost:3000"

# Тестовая авторизация: если true — принимает заголовок X-Debug-User-Id и работает без JWT.
# На продакшене оставить false.
AUTH_DEBUG_MODE="true"

# Порт (Amvera подставляет автоматически).
PORT=3000
