# Скопировать в .env и подставить реальные значения.

# ── Managed Postgres на Amvera ──────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/doska_kvn?schema=public"

# ── CORS: с каких доменов пускаем запросы ───────────────────────
CORS_ORIGINS="https://xn----7sbhf4acwc1a.xn--p1ai,https://доска-квн.рф,http://localhost:3000"

# ── Domain для cookies (общий для api. и корня) ─────────────────
# Позволяет фронту и API делить httpOnly-cookies.
COOKIE_DOMAIN=".xn----7sbhf4acwc1a.xn--p1ai"
COOKIE_SECURE="true"

# ── JWT-секреты — генерить как random 64 chars ──────────────────
# Пример: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-random-64-hex"
JWT_REFRESH_SECRET="change-me-another-random-64-hex"

# TTL токенов
JWT_ACCESS_TTL_SEC="900"           # 15 минут
JWT_REFRESH_TTL_SEC="7776000"      # 90 дней

# ── Unisender Go — отправка кодов на email ──────────────────────
UNISENDER_GO_API_KEY=""
UNISENDER_GO_SENDER_EMAIL="noreply@доска-квн.рф"
UNISENDER_GO_SENDER_NAME="Доска/КВН"

# Rate limits (за минуту)
EMAIL_CODE_INTERVAL_SEC="60"       # Сколько сек ждать между запросами кода
EMAIL_CODE_MAX_ATTEMPTS="5"        # Сколько раз можно вводить неверный код

# ── Debug: тестовая auth через X-Debug-User-Id ──────────────────
# ВАЖНО: только в dev. На проде — false.
AUTH_DEBUG_MODE="false"

# ── Прочее ──────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL="https://xn----7sbhf4acwc1a.xn--p1ai"
