{
  "name": "doska-kvn-api",
  "version": "0.1.0",
  "private": true,
  "description": "API backend for Доска/КВН",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "NODE_OPTIONS='--max-old-space-size=768' nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:migrate:prod": "prisma db push --skip-generate && node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/throttler": "6.2.1",
    "@prisma/client": "5.19.1",
    "@types/multer": "^2.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "compression": "^1.8.2",
    "cookie-parser": "1.4.7",
    "helmet": "7.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "20.12.7",
    "@types/web-push": "^3.6.4",
    "prisma": "5.19.1",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "overrides": {
    "multer": "2.4.0",
    "body-parser": "1.20.8",
    "qs": "6.16.0",
    "lodash": "4.18.1"
  }
}
